#!/bin/sh
# Block a commit whose staged content carries an embargoed token.
# See scripts/embargo-guard.mjs for why the check is digest-based.
#
# Enable (one-time, per clone):  git config core.hooksPath .githooks
# This hook is bypassable with --no-verify, which is why the same check also runs
# as the `embargo` job in .github/workflows/ci.yml on every push and PR.

set -e

if ! command -v node >/dev/null 2>&1; then
	echo "embargo-guard: node not found; cannot verify staged content." >&2
	echo "embargo-guard: refusing the commit (fail closed)." >&2
	exit 1
fi

# Resolve the guard by THIS HOOK's location, not `git rev-parse --show-toplevel`.
# In a worktree whose branch predates the guard, the toplevel has no scripts/ and
# no .githooks/ — and with a relative core.hooksPath git finds no hook there at
# all and silently commits. Set core.hooksPath to an ABSOLUTE path (see README)
# and this resolves back to the checkout that actually holds the guard.
GUARD_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

exec node "$GUARD_ROOT/scripts/embargo-guard.mjs" --staged

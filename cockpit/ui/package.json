    "sidecar": "node scripts/build-sidecar.mjs",
    "sidecar:release": "node scripts/build-sidecar.mjs --release",
    "desktop": "npm run sidecar && tauri dev",
    "bundle": "npm run sidecar:release && tauri build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/svelte": "^5.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.3",
    "jsdom": "^25.0.1",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "js-yaml": "^5.2.1",
    "marked": "^18.0.5"
  }
}

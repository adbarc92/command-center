# command-center — environment template.
# Copy this to `.env` (which is gitignored) and fill in your key:
#     cp .env.example .env
# Both `run_once` and `serve` auto-load `.env` from the repo root.

# ── REQUIRED for REAL agent runs ──────────────────────────────────────────────
# A spend-capped Anthropic API key. Create one at https://console.anthropic.com
# and set a low monthly limit. It is forwarded into the agent container via -e and
# never written to a command line. DEMO-mode missions do not need it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional knobs (defaults shown; uncomment to override) ─────────────────────

# Target repository for run_once / server missions:
# CC_REPO_URL=https://github.com/adbarc92/command-center-agent-sandbox
# CC_REPO_SLUG=adbarc92/command-center-agent-sandbox
# CC_BASE_BRANCH=main

# The objective check (test) command run inside the container:
# CC_TEST_CMD=node --test

# Agent container image (use cc-agent:stub for a $0 dry run):
# CC_IMAGE=cc-agent:dev

# Hard USD ceiling per unit (run_once). The agent also gets --max-budget-usd,
# and the daemon halts the unit if cumulative cost exceeds this:
# CC_USD_CAP=3.0

# Wall-clock ceiling in seconds (run_once); backstop against a time/loop runaway:
# CC_WALL_SECS=1800

# Minimum review rounds before auto-advance (run_once); 1 keeps first runs cheap:
# CC_MIN_ROUNDS=1

# NOTE ON COST SAFETY: Anthropic has no per-key spend limit, but you can set a
# monthly spend limit on a WORKSPACE (Console -> Settings -> Workspaces) and
# create your key inside it. Use that as the hard external backstop in addition
# to CC_USD_CAP / CC_WALL_SECS above.

# Daemon bind address (serve):
# CC_ADDR=127.0.0.1:8787

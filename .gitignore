
/spikes/artifacts/
/target/

# local secrets
.env

/fleet.db
/fleet.db-wal
/fleet.db-shm

# restart-recovery demo scratch db (scripts/demo-restart-recovery.mjs)
/demo-*.db
/demo-*.db-wal
/demo-*.db-shm
.superpowers/

# runtime SQLite lives under the tauri crate, not repo root
/cockpit/ui/src-tauri/fleet.db
/cockpit/ui/src-tauri/fleet.db-shm
/cockpit/ui/src-tauri/fleet.db-wal

# git worktrees + local claude overlay
# settings.json is a per-machine permission allowlist (absolute paths, broad grants) —
# keep it out of shared history like settings.local.json; it stays live locally, untracked.
/.claude/worktrees/
/.claude/settings.json
/.claude/settings.local.json

# ContextCurator local store (user's product data, not ours to track)
/.context-curator/

# embargo guard denylist — digests of low-entropy tokens are crackable, so the
# denylist is never committed (see scripts/embargo-guard.mjs)
/.embargo-guard.local.json
